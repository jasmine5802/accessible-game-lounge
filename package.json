{
  "name": "accessible-game-lounge",
  "version": "1.0.58",
  "description": "Playroom style accessible multiplayer game lounge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "node server.js",
    "test:uno": "node uno-rules.test.js",
    "test:lobby": "node lobby-flow.test.js",
    "test:computer": "node computer-player.test.js",
    "test:monopoly": "node monopoly-boards.test.js",
    "test:monopoly-jackpot": "node monopoly-jackpot.test.js",
    "test:multiplayer": "node multiplayer-counts.test.js",
    "test:full-gameplay": "node full-gameplay.test.js",
    "test:mixed-mode": "node mixed-mode.test.js",
    "test:options": "node game-options.test.js",
    "test:yesno": "node yes-no-flow.test.js",
    "test:prompt-coverage": "node prompt-coverage.test.js",
    "test:enter-smoke": "npm run test:yesno && npm run test:prompt-coverage && npm run test:options",
    "test:desktop-multiplayer": "node desktop-multiplayer.test.js",
    "test:desktop-prompts": "node desktop-prompt-keys.test.js",
    "test:quit-list": "node quit-to-list.test.js",
    "test:lounge-prompts": "node lounge-prompt-flow.test.js",
    "test:accessible-mode": "node accessible-mode.test.js",
    "test:card-accessibility": "node duck-race-accessibility.test.js",
    "test:visual-mode": "node visual-mode.test.js",
    "test:join-announcements": "node game-join-announcements.test.js",
    "test:desktop-server": "node main.test.js",
    "verify:render-version": "node --use-system-ca verify-render-version.js",
    "release:check": "npm run test:yesno && npm run test:prompt-coverage && npm run test:lounge-prompts && npm run test:accessible-mode && npm run test:card-accessibility && npm run test:visual-mode && npm run test:join-announcements && npm run test:mixed-mode && npm run test:desktop-prompts && npm run test:desktop-server && npm run test:quit-list && npm run test:desktop-multiplayer && npm run test:lobby && npm run test:options && npm run test:full-gameplay && npm run verify:render-version",
    "release:win": "npm run release:check && npm run build-installer",
    "dev": "node server.js",
    "package-win": "electron-packager . AccessibleGameLounge --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/node_modules\\.pre-npm-install($|/)\" --ignore=\"^/dist($|/)\" --ignore=\"^/users\\.json(?:\\.tmp)?$\"",
    "build-installer": "npm run verify:render-version && electron-builder --win"
  },
  "keywords": [
    "accessibility",
    "multiplayer",
    "games",
    "socket.io",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "asar": false,
    "appId": "com.jazzyjay.accessiblegamelounge",
    "productName": "Jazzy Jay's Accessible Game Lounge",
    "directories": {
      "output": "dist"
    },
    "artifactName": "AccessibleGameLounge Setup ${version}.${ext}",
    "files": [
      "**/*",
      "!users.json",
      "!users.json.tmp",
      "!node_modules.pre-npm-install/**",
      "!dist/**",
      "!installer-dist/**",
      "!installer-dist-*/**",
      "!installer-final-*/**",
      "!electron-base-*/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Jazzy Jay's Accessible Game Lounge",
      "uninstallDisplayName": "Jazzy Jay's Accessible Game Lounge",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=18"
  }
}
